VITE_API_URL=http://localhost:3001
VITE_USE_FAKE_LOGIN=false
VITE_DEEP_LINK_SCHEME=androidstarter
VITE_DEEP_LINK_HOST=auth

# OTA / Live Updates (ver docs/native/OTA.md). Mantenha false ate ter R2 + release de loja com o plugin.
# VITE_OTA_ENABLED=false
# Canal inicial bake-time: production (default) | staging. staging so em builds locais (.env.simulator);
# nunca em .env.production. A preferencia do device (12 toques) vence em runtime.
# VITE_OTA_CHANNEL=production
