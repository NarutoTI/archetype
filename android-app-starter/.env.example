VITE_API_URL=http://localhost:3001
VITE_USE_FAKE_LOGIN=false
VITE_DEEP_LINK_SCHEME=androidstarter
VITE_DEEP_LINK_HOST=auth

# Seletor nativo do Google (ver docs/native/GOOGLE-LOGIN.md). Client OAuth **web** do projeto no
# Google Cloud — o mesmo GOOGLE_CLIENT_ID do backend, que valida o ID token contra ele.
# Vazio: o app usa só o Custom Tab, como antes. Não é o client Android (esse só cadastra
# pacote + SHA-1) nem o JSON baixado dele.
VITE_GOOGLE_WEB_CLIENT_ID=

# OTA / Live Updates (ver docs/native/OTA.md). Mantenha false ate ter R2 + release de loja com o plugin.
# VITE_OTA_ENABLED=false
# Canal inicial bake-time: production (default) | staging. staging so em builds locais (.env.simulator);
# nunca em .env.production. A preferencia do device (12 toques) vence em runtime.
# VITE_OTA_CHANNEL=production
# key-v2 (OTA cifrada): true rejeita descriptor sem sessionKey. Ligue so na MESMA
# release nativa que passar a assinar as OTAs (a AAB que leva a publicKey).
# VITE_OTA_REQUIRE_SIGNED=false
