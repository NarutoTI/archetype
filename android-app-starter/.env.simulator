# Emulador Android (build:simulator -> vite build --mode simulator).
# Herda os comuns do .env; aqui só o que muda pro emulador:
# - API no host via 10.0.2.2 (alias do emulador pro localhost da maquina);
# - OTA ligado + canal de teste (staging) por padrao, sem precisar dos 12 toques.
# build:android/build NAO usam este arquivo (usam .env.production, sempre production).
VITE_API_URL=http://10.0.2.2:3001
VITE_OTA_ENABLED=true
VITE_OTA_CHANNEL=staging
